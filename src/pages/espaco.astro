---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { ADDRESS_L1, ADDRESS_L2, ADDRESS_L3, MAPS_URL, WAZE_URL, MAPS_EMBED } from '../data';

const welcome = [
  { t: 'Acolhimento', d: 'Empresa que acolhe a comunidade LGBTQ+ e espaço seguro para pessoas transgênero.', pride: true },
  { t: 'Acessibilidade', d: 'Entrada, assento, banheiro e estacionamento acessíveis para cadeira de rodas.' },
  { t: 'Banheiro', d: 'Banheiro disponível para clientes, incluindo banheiro de gênero neutro.' },
  { t: 'Estacionamento', d: 'Gratuito, na rua e no próprio Street Shopping Planalto.' },
  { t: 'Pagamento', d: 'Cartão de crédito, débito e pagamento por aproximação.' },
];
---
<Base
  title="O espaço | BHZ Óptica, Street Shopping Planalto"
  description="Conheça a loja da BHZ Óptica no Street Shopping Planalto, em Belo Horizonte: acessível, acolhedora e com estacionamento gratuito."
  current="espaco"
>
  <section class="page-hero">
    <div class="wrap">
      <h1 class="page-h1">O espaço</h1>
      <div class="page-hero-row">
        <p class="lede">Uma loja clara, de vitrine aberta para o corredor do shopping, com balcões de vidro, espelho em cada lugar e cadeiras para escolher sentado.</p>
        <p class="page-hero-meta">{ADDRESS_L1}<br />Planalto, Belo Horizonte</p>
      </div>
    </div>
  </section>

  <section class="esp-collage" aria-label="Fotos da loja">
    <div class="wrap collage-grid">
      <figure class="cl-main" data-reveal>
        <Img name="interior" alt="Interior da loja com balcões de vidro, espelhos e cadeiras vermelhas" sizes="(min-width: 900px) 58vw, 100vw" eager />
      </figure>
      <figure class="cl-video" data-reveal>
        <video src="/video/espaco.mp4" poster="/img/v1-800.webp" autoplay muted loop playsinline controls aria-label="Vídeo da fachada e do interior da loja"></video>
        <figcaption>A loja, da fachada ao balcão</figcaption>
      </figure>
      <figure class="cl-a" data-reveal>
        <Img name="fachada" alt="Fachada da BHZ Óptica com letreiro vermelho" sizes="(min-width: 900px) 30vw, 50vw" />
        <figcaption>Fachada</figcaption>
      </figure>
      <figure class="cl-b" data-reveal>
        <Img name="v10" alt="Prateleiras com óculos de sol" sizes="(min-width: 900px) 30vw, 50vw" />
        <figcaption>Prateleiras de óculos de sol</figcaption>
      </figure>
      <figure class="cl-c" data-reveal>
        <Img name="v45" alt="Interior visto da entrada" sizes="(min-width: 900px) 30vw, 50vw" />
        <figcaption>Vista da entrada</figcaption>
      </figure>
    </div>
  </section>

  <section class="section sobre" aria-labelledby="sobre-h">
    <div class="wrap sobre-grid">
      <h2 class="display" id="sobre-h">Sobre a loja</h2>
      <div class="prose">
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.</p>
        <p>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</p>
        <p class="todo">Escrever sobre a história da loja</p>
      </div>
    </div>
  </section>

  <section class="section equipe" aria-labelledby="eq-h">
    <div class="wrap sobre-grid">
      <h2 class="display" id="eq-h">Quem atende</h2>
      <div class="prose">
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore.</p>
        <p class="todo">Colocar foto e nome da equipe</p>
      </div>
    </div>
  </section>

  <section class="section welcome" aria-labelledby="wel-h">
    <div class="wrap">
      <header class="sec-head">
        <h2 class="display" id="wel-h">Para todo mundo</h2>
        <div class="sec-head-side"><p class="lede">O que você encontra antes mesmo de escolher a armação.</p></div>
      </header>
      <ul class="index-list index-static">
        {welcome.map((w) => (
          <li class={`index-row ${w.pride ? 'is-pride' : ''}`}>
            <h3 class="index-t">{w.t}</h3>
            <p class="index-d">{w.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="map-strip" aria-label="Como chegar">
    <iframe src={MAPS_EMBED} title="Mapa: BHZ Óptica no Street Shopping Planalto" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    <div class="map-card">
      <h2 class="map-h">Como chegar</h2>
      <p>{ADDRESS_L1}<br />{ADDRESS_L2}<br />{ADDRESS_L3}</p>
      <p class="map-links"><a href={MAPS_URL} target="_blank" rel="noopener">Google Maps</a><a href={WAZE_URL} target="_blank" rel="noopener">Waze</a></p>
    </div>
  </section>
</Base>
