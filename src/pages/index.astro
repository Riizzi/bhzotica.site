---
import Base from '../layouts/Base.astro';
import EyeChart from '../components/EyeChart.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import Orcamento from '../components/Orcamento.astro';
import MapBlock from '../components/MapBlock.astro';
import { PHONE_DISPLAY, MAPS_URL, COLECAO } from '../data';

const faqs = [
  'Quanto tempo leva para os óculos ficarem prontos?',
  'Posso parcelar?',
  'Vocês aceitam receita de qualquer oftalmologista?',
  'Dá para trocar só as lentes da minha armação?',
  'Os óculos têm garantia?',
  'Vocês fazem ajuste e conserto?',
];

const reviews = [
  { name: 'Dj Sid Pacheco', when: 'há 6 meses', text: 'Excelente atendimento e ótimos preços! Fui muito bem atendido pelo Warllen! Super indico!' },
  { name: 'Ana Paula Oliveira', when: 'há 2 meses', text: 'Excelente atendimento e lindos modelos de óculos de sol e de grau.' },
  { name: 'Alessandra Meira', when: 'há 4 meses', text: 'Excelente atendimento. Óculos de qualidade. Fiquei muito satisfeita!' },
];
---
<Base
  title="BHZ Óptica | Óculos de grau, de sol e lentes no Planalto, BH"
  description="Óptica no Street Shopping Planalto, em Belo Horizonte: óculos de grau e de sol, lentes multifocais e lentes de contato."
>
  <!-- INÍCIO -->
  <section class="hero">
    <EyeChart />
    <div class="wrap hero-foot">
      <p class="hero-lede">Óculos de grau e de sol, lentes multifocais e de contato no Street Shopping Planalto. Vem provar com calma, a gente ajuda a escolher.</p>
      <nav class="quick" aria-label="Atalhos">
        <a href="/colecao" class="quick-a"><Icon name="glasses" /><span>Coleção</span></a>
        <a href="/guia" class="quick-a"><Icon name="book" /><span>Guia</span></a>
        <a href="/atendimento" class="quick-a"><Icon name="store" /><span>Atendimento</span></a>
        <a href="#onde" class="quick-a"><Icon name="pin" /><span>Como chegar</span></a>
      </nav>
    </div>
  </section>

  <!-- COLEÇÃO (resumo) -->
  <section class="section col-sum" aria-labelledby="col-h">
    <div class="wrap">
      <header class="sec-head">
        <h2 class="display" id="col-h">A coleção</h2>
        <div class="sec-head-side">
          <p class="lede">Ray-Ban, Varilux, Zeiss, Acuvue e mais. Armações para provar diante do espelho, sem pressa.</p>
          <a class="btn btn-ink" href="/colecao">Ver coleção completa<Icon name="arrow" /></a>
        </div>
      </header>
      <div class="col-row">
        {COLECAO.slice(0, 3).map((c, i) => (
          <a href="/colecao" class={`col-card col-card-${i}`}>
            <div class="col-img" data-reveal><Img name={c.img} alt={c.alt} sizes="(min-width: 900px) 33vw, 80vw" /></div>
            <span class="col-cap"><b>{c.brand}</b>{c.desc}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FEEDBACKS -->
  <section class="section reviews" aria-labelledby="rev-h">
    <div class="wrap">
      <header class="rev-head">
        <h2 class="display" id="rev-h">Quem já passou por aqui</h2>
        <p class="rev-score"><span class="stars" aria-hidden="true">★★★★★</span>no Google</p>
      </header>
      <div class="rev-grid">
        {reviews.map((r, i) => (
          <figure class={`rev rev-${i}`}>
            <blockquote><p>{r.text}</p></blockquote>
            <figcaption><b>{r.name}</b><span>{r.when}</span></figcaption>
          </figure>
        ))}
      </div>
      <p class="rev-more"><a class="pill pill-light" href={MAPS_URL} target="_blank" rel="noopener">Ver todas as avaliações no Google<Icon name="arrow" /></a></p>
    </div>
  </section>

  <!-- ENDEREÇO -->
  <MapBlock id="onde" title="Onde estamos" />

  <!-- ATENDIMENTO -->
  <section class="section at-sec" id="orcamento" aria-labelledby="at-h">
    <div class="wrap at-grid">
      <div class="at-intro">
        <h2 class="display" id="at-h">Atendimento</h2>
        <p class="lede">Conta pra gente o que você procura. A mensagem fica pronta e você só envia no WhatsApp.</p>
        <p class="at-phone">Prefere ligar? <a href="tel:+553133245968">{PHONE_DISPLAY}</a></p>
        <a class="link-arrow" href="/atendimento">Conhecer a loja e a equipe</a>
      </div>
      <Orcamento />
    </div>
  </section>

  <!-- PERGUNTAS FREQUENTES -->
  <section class="section faq" aria-labelledby="faq-h">
    <div class="wrap faq-grid">
      <div>
        <h2 class="display" id="faq-h">Perguntas frequentes</h2>
        <p class="todo">Responder as perguntas com o dono</p>
      </div>
      <div class="faq-list">
        {faqs.map((q) => (
          <details>
            <summary>{q}</summary>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
