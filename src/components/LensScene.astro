---
// Cena com rolagem: colagem editorial; a imagem das lentes cresce do painel direito até ocupar a tela.
import Img from './Img.astro';
---
<section class="scene" id="lentes" data-scene aria-labelledby="scene-h">
  <div class="scene-sticky" data-scene-sticky>
    <div class="scene-left" data-scene-fade>
      <Img name="interior" alt="Interior da BHZ Óptica com balcões de vidro e espelhos" sizes="30vw" />
    </div>
    <div class="scene-inset" data-scene-fade>
      <Img name="sol-2" alt="Óculos aviador Ray-Ban sobre o estojo de couro" sizes="22vw" />
    </div>
    <div class="scene-text" data-scene-fade>
      <h2 class="scene-h" id="scene-h">Cada distância pede uma lente.</h2>
      <p>Longe, meia distância, perto. A lente certa resolve as três sem você precisar trocar de óculos.</p>
    </div>

    <div class="scene-full">
      <div class="scene-full-bg" aria-hidden="true"></div>
      <Img name="lentes" alt="Comparação: a lente bifocal tem duas zonas, longe e perto; a multifocal tem longe, médio e perto em transição contínua" sizes="100vw" class="scene-full-img" />
      <div class="scene-shade" aria-hidden="true"></div>
    </div>

    <div class="scene-captions">
      <div class="scene-cap">
        <h3>Bifocal</h3>
        <p>Duas zonas na mesma lente: longe em cima, perto embaixo, com a divisão visível no vidro.</p>
      </div>
      <div class="scene-cap">
        <h3>Multifocal</h3>
        <p>Longe, médio e perto em transição contínua e sem linha aparente. Indicada para quem começou a ter dificuldade de enxergar de perto.</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Progresso da rolagem suavizado (interpolação a cada quadro) para o movimento ficar fluido.
  const scene = document.querySelector<HTMLElement>('[data-scene]');
  const sticky = document.querySelector<HTMLElement>('[data-scene-sticky]');
  if (scene && sticky) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const target = () => {
      const r = scene.getBoundingClientRect();
      return clamp(-r.top / Math.max(1, r.height - window.innerHeight));
    };
    let p = target(), raf = 0;
    const paint = () => {
      sticky.style.setProperty('--f', clamp(p / 0.32).toFixed(4));
      sticky.style.setProperty('--e', ease(clamp(p / 0.62)).toFixed(4));
      sticky.style.setProperty('--c', ease(clamp((p - 0.58) / 0.3)).toFixed(4));
    };
    const loop = () => {
      const t = target();
      p += (t - p) * (reduce ? 1 : 0.16);
      if (Math.abs(t - p) < 0.0005) p = t;
      paint();
      raf = p === t ? 0 : requestAnimationFrame(loop);
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(loop); };
    paint();
    window.addEventListener('scroll', kick, { passive: true });
    window.addEventListener('resize', kick);
  }
</script>
