---
// Faixa horizontal de ponta a ponta: a própria mídia, desfocada, preenche a largura;
// a versão nítida fica no tamanho original (as fotos têm 540px — não esticamos).
interface Props { bg: string; id?: string; flip?: boolean; class?: string }
const { bg, id, flip = false, class: cls = '' } = Astro.props;
---
<section class={`band ${flip ? 'band-flip' : ''} ${cls}`} id={id}>
  <div class="band-bg" style={`background-image:url(${bg})`} aria-hidden="true"></div>
  <div class="wrap band-inner">
    <div class="band-media"><slot name="media" /></div>
    <div class="band-copy"><slot /></div>
  </div>
</section>
