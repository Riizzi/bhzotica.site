---
// Óculos aviador em pixels, dissolvendo à esquerda — releitura vetorial do logo da BHZ.
interface Props { cols?: number; scatter?: boolean; class?: string; label?: string }
const { cols = 48, scatter = true, class: cls = '', label } = Astro.props;
const W = cols, H = Math.round(cols * 0.44);
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const lens = (x: number, y: number, cx: number) => {
  const rx = W * 0.235, ry = H * 0.95, top = 1.2;
  if (y < top) return false;
  const dx = (x - cx) / rx, dy = (y - top) / ry;
  // aviador: mais largo no alto, afunila para o nariz
  const k = x < cx === cx < W / 2 ? 1 : 1 + dy * 0.35;
  return (dx * k) ** 2 + dy ** 2 <= 1;
};
const cells: { x: number; y: number; s: number; o: number }[] = [];
for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
  const cx = x + 0.5, cy = y + 0.5;
  const brow = y < 1.2 && cx > W * 0.04 && cx < W * 0.96;
  const inside = brow || lens(cx, cy, W * 0.265) || lens(cx, cy, W * 0.735);
  if (!inside) continue;
  const t = cx / W;
  const keep = scatter ? Math.min(1, Math.max(0, (t - 0.02) / 0.3)) ** 0.8 : 1;
  if (rnd() < keep) { cells.push({ x, y, s: 1, o: 1 }); continue; }
  if (rnd() < 0.55) {
    const s = 0.5 + rnd() * 0.45;
    cells.push({ x: x - rnd() * W * 0.32, y: y - 1.5 + (rnd() - 0.5) * H * 0.5, s, o: 0.55 + rnd() * 0.45 });
  }
}
const minX = scatter ? -W * 0.34 : 0, minY = scatter ? -H * 0.3 : 0;
const vb = `${minX} ${minY} ${W - minX} ${H - minY}`;
const g = 0.14;
---
<svg class={`pixel-glasses ${cls}`} viewBox={vb} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} fill="currentColor">
  {cells.map((c) => <rect x={c.x + g / 2} y={c.y + g / 2} width={c.s - g} height={c.s - g} opacity={c.o} />)}
</svg>
