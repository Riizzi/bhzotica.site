---
// Imagens tratadas em public/img/<nome>-{480,800,1600}.webp e -1600.jpg.
// width/height reservam o espaço da foto antes de carregar (evita pulo de layout).
const DIMS: Record<string, [number, number]> = {
  contato: [1600, 1292], lentes: [1600, 1292], 'sol-1': [1600, 1292], 'sol-2': [1600, 1292], 'sol-3': [1600, 1292], 'sol-4': [1600, 1292],
  fachada: [1600, 2634], interior: [1600, 2634],
  v1: [1472, 1984], v10: [1472, 1984], v125: [1472, 1984], v45: [1472, 1984], v75: [1472, 1984],
};
interface Props { name: string; alt: string; sizes?: string; class?: string; eager?: boolean }
const { name, alt, sizes = '100vw', class: cls, eager = false } = Astro.props;
const b = `/img/${name}`;
const [w, h] = DIMS[name] ?? [1600, 1292];
---
<picture class={cls}>
  <source type="image/webp" srcset={`${b}-480.webp 480w, ${b}-800.webp 800w, ${b}-1600.webp 1600w`} sizes={sizes} />
  <img src={`${b}-1600.jpg`} alt={alt} width={w} height={h} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding={eager ? 'sync' : 'async'} />
</picture>
