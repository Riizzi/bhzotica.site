---
// Imagens tratadas em public/img/<nome>-800.webp, -1600.webp e -1600.jpg
interface Props { name: string; alt: string; sizes?: string; class?: string; eager?: boolean; w?: number; h?: number }
const { name, alt, sizes = '100vw', class: cls, eager = false, w, h } = Astro.props;
const b = `/img/${name}`;
---
<picture class={cls}>
  <source type="image/webp" srcset={`${b}-800.webp 800w, ${b}-1600.webp 1600w`} sizes={sizes} />
  <img src={`${b}-1600.jpg`} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" width={w} height={h} />
</picture>
